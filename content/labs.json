[
  {
    "id": "oe-lab-perm-01",
    "kind": "linux",
    "mode": "state-sim",
    "level": "L2",
    "title": "协作目录：用户、组与权限",
    "subtitle": "/srv/share 的 setgid + sticky 组合",
    "domain": "oe",
    "topic_id": "oe-02",
    "section_id": "oe-02-04",
    "version": "openEuler 24.03-LTS-SP2",
    "minutes": 15,
    "scenario": "团队要在 /srv/share 里协作：dev 组成员都能读写，新建的文件自动属于 dev 组，但任何人都不能删除别人建的文件。alice 原本就在 ops 组，不能把她从 ops 里踢出去。",
    "objectives": [
      "用 -aG 追加附加组而不是覆盖",
      "用 chgrp + chmod 组合出 3770",
      "验证 setgid 让新文件继承属组",
      "验证 sticky 阻止跨用户删除"
    ],
    "tasks": [
      { "id": "t1", "text": "创建 dev 组，把 alice 追加进去（保留她原有的 ops 组）" },
      { "id": "t2", "text": "把 bob 也加入 dev 组" },
      { "id": "t3", "text": "把 /srv/share 的属组改为 dev" },
      { "id": "t4", "text": "把 /srv/share 设为 3770：属组可写、新文件继承 dev 组、组内不能删别人的文件" },
      { "id": "t5", "text": "以 alice 身份在 /srv/share 下创建 notes.md，并确认它的属组是 dev" },
      { "id": "t6", "text": "验证：root 能删 old.txt，alice 删不掉（用 rm 试一次，看返回什么）" }
    ],
    "validators": [
      { "id": "v1", "label": "dev 组已创建", "weight": 10, "path": ["groups", "dev"], "op": "exists" },
      { "id": "v2", "label": "alice 已加入 dev", "weight": 10, "path": ["users", "alice", "groups"], "op": "contains", "value": "dev" },
      { "id": "v3", "label": "alice 仍保留 ops 附加组", "weight": 10, "path": ["users", "alice", "groups"], "op": "contains", "value": "ops" },
      { "id": "v4", "label": "/srv/share 属组为 dev", "weight": 15, "path": ["files", "/srv/share", "group"], "op": "eq", "value": "dev" },
      { "id": "v5", "label": "/srv/share 权限为 3770", "weight": 20, "path": ["files", "/srv/share", "mode"], "op": "eq", "value": "3770" },
      { "id": "v6", "label": "alice 已创建 notes.md", "weight": 15, "path": ["files", "/srv/share/notes.md"], "op": "exists" },
      { "id": "v7", "label": "notes.md 属组为 dev（setgid 生效）", "weight": 20, "path": ["files", "/srv/share/notes.md", "group"], "op": "eq", "value": "dev" }
    ],
    "hints": [
      { "text": "`usermod -aG dev alice` 的 `-a` 是追加，漏掉就变成覆盖，ops 会丢。", "cost": 5 },
      { "text": "setgid 是四位权限的第一位 2，sticky 是 1；两个都要就是 3 开头。", "cost": 5 },
      { "text": "切换身份执行命令：`sudo -u alice touch /srv/share/notes.md`。", "cost": 5 }
    ],
    "solution": [
      "groupadd dev",
      "usermod -aG dev alice",
      "usermod -aG dev bob",
      "chgrp dev /srv/share",
      "chmod 3770 /srv/share",
      "sudo -u alice touch /srv/share/notes.md",
      "ls -l /srv/share"
    ],
    "initial_state": {
      "host": "euler01",
      "user": "root",
      "cwd": "/root",
      "umask": "022",
      "users": {
        "root": { "uid": 0, "groups": ["root"], "home": "/root", "shell": "/bin/bash" },
        "alice": { "uid": 1001, "groups": ["alice", "ops"], "home": "/home/alice", "shell": "/bin/bash" },
        "bob": { "uid": 1002, "groups": ["bob"], "home": "/home/bob", "shell": "/bin/bash" },
        "carol": { "uid": 1003, "groups": ["carol"], "home": "/home/carol", "shell": "/bin/bash" }
      },
      "groups": {
        "root": { "gid": 0 },
        "alice": { "gid": 1001 },
        "bob": { "gid": 1002 },
        "carol": { "gid": 1003 },
        "ops": { "gid": 1004 }
      },
      "files": {
        "/": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/etc": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/etc/fstab": { "type": "file", "owner": "root", "group": "root", "mode": "644", "content": "UUID=1f2a-3c4d / xfs defaults 0 0\n" },
        "/home": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/home/alice": { "type": "dir", "owner": "alice", "group": "alice", "mode": "700" },
        "/home/bob": { "type": "dir", "owner": "bob", "group": "bob", "mode": "700" },
        "/home/carol": { "type": "dir", "owner": "carol", "group": "carol", "mode": "700" },
        "/srv": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/srv/share": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/srv/share/old.txt": { "type": "file", "owner": "bob", "group": "bob", "mode": "644", "content": "bob 的历史文件\n" }
      },
      "services": {},
      "firewall": { "running": true, "zone": "public", "runtime": { "ports": [], "services": ["ssh"] }, "permanent": { "ports": [], "services": ["ssh"] } },
      "disks": {},
      "pvs": {},
      "vgs": {},
      "lvs": {},
      "mounts": { "/": { "dev": "/dev/vda1", "type": "xfs" } },
      "fstab": [{ "spec": "UUID=1f2a-3c4d", "mount": "/", "type": "xfs", "options": "defaults", "dump": "0", "pass": "0" }]
    }
  },
  {
    "id": "oe-lab-svc-01",
    "kind": "linux",
    "mode": "state-sim",
    "level": "L2",
    "title": "服务自启与端口持久放行",
    "subtitle": "systemctl 与 firewalld 的两套状态",
    "domain": "oe",
    "topic_id": "oe-03",
    "section_id": "oe-03-02",
    "version": "openEuler 24.03-LTS-SP2",
    "minutes": 12,
    "scenario": "app 服务装在 /opt/app，监听 8080。要求：现在就要跑起来，重启后也要自动跑；防火墙放行 8080/tcp，而且重启后规则不能丢。",
    "objectives": [
      "用 enable --now 一次完成“现在启动 + 开机自启”",
      "分清 firewall-cmd 的 runtime 与 permanent 两套配置",
      "用 --reload 把持久配置刷进运行时"
    ],
    "tasks": [
      { "id": "t1", "text": "启动 app 服务，并设为开机自启" },
      { "id": "t2", "text": "持久放行 8080/tcp，并让它立即生效" },
      { "id": "t3", "text": "用 ss -lntp 确认 8080 在监听，用 firewall-cmd --list-all 确认端口已放行" }
    ],
    "validators": [
      { "id": "v1", "label": "app.service 正在运行", "weight": 25, "path": ["services", "app.service", "active"], "op": "eq", "value": true },
      { "id": "v2", "label": "app.service 已设为开机自启", "weight": 25, "path": ["services", "app.service", "enabled"], "op": "eq", "value": true },
      { "id": "v3", "label": "运行时已放行 8080/tcp", "weight": 25, "path": ["firewall", "runtime", "ports"], "op": "contains", "value": "8080/tcp" },
      { "id": "v4", "label": "持久配置已放行 8080/tcp", "weight": 25, "path": ["firewall", "permanent", "ports"], "op": "contains", "value": "8080/tcp" }
    ],
    "hints": [
      { "text": "`systemctl start` 只改当前状态，`enable` 只改开机策略；两个都要写 `enable --now`。", "cost": 5 },
      { "text": "`firewall-cmd --add-port=8080/tcp` 只改运行时；加 `--permanent` 改的是持久配置，但不会立刻生效。", "cost": 5 },
      { "text": "先 `--permanent --add-port=8080/tcp`，再 `--reload`，两套配置就都对了。", "cost": 5 }
    ],
    "solution": [
      "systemctl enable --now app.service",
      "systemctl status app.service",
      "firewall-cmd --permanent --add-port=8080/tcp",
      "firewall-cmd --reload",
      "firewall-cmd --query-port=8080/tcp",
      "ss -lntp"
    ],
    "initial_state": {
      "host": "euler01",
      "user": "root",
      "cwd": "/root",
      "umask": "022",
      "users": { "root": { "uid": 0, "groups": ["root"], "home": "/root", "shell": "/bin/bash" } },
      "groups": { "root": { "gid": 0 } },
      "files": {
        "/": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/etc": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/etc/fstab": { "type": "file", "owner": "root", "group": "root", "mode": "644", "content": "UUID=1f2a-3c4d / xfs defaults 0 0\n" },
        "/etc/systemd": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/etc/systemd/system": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/etc/systemd/system/app.service": {
          "type": "file", "owner": "root", "group": "root", "mode": "644",
          "content": "[Unit]\nDescription=Demo App\nAfter=network.target\n\n[Service]\nExecStart=/opt/app/server --port 8080\nRestart=on-failure\n\n[Install]\nWantedBy=multi-user.target\n"
        },
        "/opt": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/opt/app": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/opt/app/server": { "type": "file", "owner": "root", "group": "root", "mode": "755", "content": "ELF 64-bit LSB executable, ARM aarch64\n" },
        "/var": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/var/log": { "type": "dir", "owner": "root", "group": "root", "mode": "755" }
      },
      "services": {
        "app.service": { "active": false, "enabled": false, "port": 8080, "desc": "Demo App" }
      },
      "firewall": { "running": true, "zone": "public", "runtime": { "ports": [], "services": ["ssh"] }, "permanent": { "ports": [], "services": ["ssh"] } },
      "disks": {},
      "pvs": {},
      "vgs": {},
      "lvs": {},
      "mounts": { "/": { "dev": "/dev/vda1", "type": "xfs" } },
      "fstab": [{ "spec": "UUID=1f2a-3c4d", "mount": "/", "type": "xfs", "options": "defaults", "dump": "0", "pass": "0" }]
    }
  },
  {
    "id": "oe-lab-lvm-01",
    "kind": "linux",
    "mode": "state-sim",
    "level": "L2",
    "title": "LVM 建卷、持久挂载与扩容",
    "subtitle": "从空盘到 /data，再扩 5G",
    "domain": "oe",
    "topic_id": "oe-05",
    "section_id": "oe-05-02",
    "version": "openEuler 24.03-LTS-SP2",
    "minutes": 18,
    "scenario": "新加了一块 20G 的空盘 /dev/vdb。要求：用 LVM 划出 5G 给 /data，格式化 XFS，写进 fstab 保证重启后自动挂载；验收后把 /data 扩到 10G。",
    "objectives": [
      "按 PV → VG → LV → 文件系统 → 挂载 的顺序操作",
      "用 blkid 取 UUID 并写入 fstab",
      "用 mount -a 与 findmnt 验证，而不是重启赌",
      "用 lvextend -r 连带扩容文件系统"
    ],
    "tasks": [
      { "id": "t1", "text": "把 /dev/vdb 做成 PV" },
      { "id": "t2", "text": "创建卷组 vg_data，并把该 PV 加进去" },
      { "id": "t3", "text": "在 vg_data 上创建 5G 的逻辑卷 lv_app" },
      { "id": "t4", "text": "把逻辑卷格式化为 XFS" },
      { "id": "t5", "text": "挂到 /data，并用 UUID 写进 fstab，然后 mount -a 验证" },
      { "id": "t6", "text": "把 /data 扩到 10G（文件系统一起扩）" }
    ],
    "validators": [
      { "id": "v1", "label": "/dev/vdb 已成为 PV", "weight": 10, "path": ["pvs", "/dev/vdb"], "op": "exists" },
      { "id": "v2", "label": "vg_data 已包含该 PV", "weight": 10, "path": ["vgs", "vg_data", "pvs"], "op": "contains", "value": "/dev/vdb" },
      { "id": "v3", "label": "逻辑卷 lv_app 已创建", "weight": 10, "path": ["lvs", "vg_data/lv_app"], "op": "exists" },
      { "id": "v4", "label": "逻辑卷已格式化为 XFS", "weight": 15, "path": ["lvs", "vg_data/lv_app", "fs"], "op": "eq", "value": "xfs" },
      { "id": "v5", "label": "/data 已挂载到该逻辑卷", "weight": 20, "path": ["mounts", "/data", "dev"], "op": "eq", "value": "/dev/vg_data/lv_app" },
      { "id": "v6", "label": "fstab 有 /data 的 UUID 条目", "weight": 20, "path": ["fstab"], "op": "fstab_has", "value": { "mount": "/data", "specPrefix": "UUID=" } },
      { "id": "v7", "label": "逻辑卷已扩到 10G", "weight": 15, "path": ["lvs", "vg_data/lv_app", "size_mb"], "op": "gte", "value": 10240 }
    ],
    "hints": [
      { "text": "顺序是 pvcreate → vgcreate → lvcreate → mkfs.xfs → mount → fstab。跳一步后面全错。", "cost": 5 },
      { "text": "`blkid /dev/vg_data/lv_app` 取 UUID；fstab 首字段写 `UUID=xxx`，第二字段写挂载点。", "cost": 5 },
      { "text": "扩容量用 `lvextend -L +5G -r /dev/vg_data/lv_app`，`-r` 会顺带扩 XFS。", "cost": 5 },
      { "text": "写 fstab 的语法：`echo \"UUID=xxx /data xfs defaults 0 0\" >> /etc/fstab`。", "cost": 5 }
    ],
    "solution": [
      "lsblk",
      "pvcreate /dev/vdb",
      "vgcreate vg_data /dev/vdb",
      "lvcreate -L 5G -n lv_app vg_data",
      "mkfs.xfs /dev/vg_data/lv_app",
      "mkdir -p /data",
      "blkid /dev/vg_data/lv_app",
      "echo \"UUID=<上面查到的> /data xfs defaults 0 0\" >> /etc/fstab",
      "mount -a",
      "findmnt /data",
      "lvextend -L +5G -r /dev/vg_data/lv_app",
      "df -hT /data"
    ],
    "initial_state": {
      "host": "euler01",
      "user": "root",
      "cwd": "/root",
      "umask": "022",
      "users": { "root": { "uid": 0, "groups": ["root"], "home": "/root", "shell": "/bin/bash" } },
      "groups": { "root": { "gid": 0 } },
      "files": {
        "/": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/etc": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/etc/fstab": { "type": "file", "owner": "root", "group": "root", "mode": "644", "content": "UUID=1f2a-3c4d / xfs defaults 0 0\n" },
        "/mnt": { "type": "dir", "owner": "root", "group": "root", "mode": "755" },
        "/root": { "type": "dir", "owner": "root", "group": "root", "mode": "550" }
      },
      "services": {},
      "firewall": { "running": true, "zone": "public", "runtime": { "ports": [], "services": ["ssh"] }, "permanent": { "ports": [], "services": ["ssh"] } },
      "disks": {
        "/dev/vda": { "size": "40G", "note": "系统盘" },
        "/dev/vdb": { "size": "20G", "note": "空盘，未分区未格式化" }
      },
      "pvs": {},
      "vgs": {},
      "lvs": {},
      "mounts": { "/": { "dev": "/dev/vda1", "type": "xfs" } },
      "fstab": [{ "spec": "UUID=1f2a-3c4d", "mount": "/", "type": "xfs", "options": "defaults", "dump": "0", "pass": "0" }]
    }
  },
  {
    "id": "og-lab-grant-01",
    "kind": "sql",
    "mode": "state-sim",
    "level": "L2",
    "title": "最小权限授权",
    "subtitle": "只读账号要三层授权",
    "domain": "og",
    "topic_id": "og-02",
    "section_id": "og-02-02",
    "version": "openGauss 7.0",
    "minutes": 12,
    "scenario": "应用需要一个只读账号 app_ro：能连 appdb、能用 app schema、只能读 app.orders，不能改也不能删。建好后用 SET ROLE 实测一次。",
    "objectives": [
      "说出 CONNECT / USAGE / SELECT 三层各自解决什么",
      "用 GRANT 精确授权，不越权",
      "用 SET ROLE 切换身份验证权限边界"
    ],
    "tasks": [
      { "id": "t1", "text": "创建角色 app_ro（可登录）" },
      { "id": "t2", "text": "授予它对数据库 appdb 的 CONNECT" },
      { "id": "t3", "text": "授予它对 schema app 的 USAGE" },
      { "id": "t4", "text": "授予它对表 app.orders 的 SELECT" },
      { "id": "t5", "text": "切到 app_ro 实测：SELECT 成功、DELETE 被拒绝" }
    ],
    "validators": [
      { "id": "v1", "label": "角色 app_ro 已创建", "weight": 15, "path": ["roles", "app_ro"], "op": "exists" },
      { "id": "v2", "label": "已授予 appdb 的 CONNECT", "weight": 20, "path": ["grants"], "op": "grant", "value": { "priv": "CONNECT", "object": "database:appdb", "role": "app_ro" } },
      { "id": "v3", "label": "已授予 app schema 的 USAGE", "weight": 20, "path": ["grants"], "op": "grant", "value": { "priv": "USAGE", "object": "schema:app", "role": "app_ro" } },
      { "id": "v4", "label": "已授予 app.orders 的 SELECT", "weight": 25, "path": ["grants"], "op": "grant", "value": { "priv": "SELECT", "object": "table:app.orders", "role": "app_ro" } },
      { "id": "v5", "label": "没有给 app_ro 任何 DELETE 权限", "weight": 20, "path": ["grants"], "op": "grant", "value": { "priv": "DELETE", "role": "app_ro", "absent": true } }
    ],
    "hints": [
      { "text": "三层缺一不可：连不上库、看不到 schema、读不到表，分别对应 CONNECT、USAGE、SELECT。", "cost": 5 },
      { "text": "语法：`GRANT SELECT ON app.orders TO app_ro;`", "cost": 5 },
      { "text": "验证用 `SET ROLE app_ro;` 再 `SELECT * FROM app.orders;`，最后 `RESET ROLE;`。", "cost": 5 }
    ],
    "solution": [
      "CREATE ROLE app_ro LOGIN PASSWORD 'ChangeMe_2026';",
      "GRANT CONNECT ON DATABASE appdb TO app_ro;",
      "GRANT USAGE ON SCHEMA app TO app_ro;",
      "GRANT SELECT ON app.orders TO app_ro;",
      "\\du",
      "SET ROLE app_ro;",
      "SELECT * FROM app.orders;",
      "DELETE FROM app.orders WHERE id = 1;",
      "RESET ROLE;"
    ],
    "initial_state": {
      "user": "omm",
      "database": "appdb",
      "search_path": "app",
      "roles": {
        "omm": { "super": true, "login": true },
        "app_owner": { "login": true },
        "app_rw": { "login": true }
      },
      "databases": { "appdb": { "owner": "omm" }, "postgres": { "owner": "omm" } },
      "schemas": { "app": { "owner": "app_owner" }, "public": { "owner": "omm" } },
      "tables": {
        "app.orders": { "owner": "app_owner", "columns": ["id", "customer_id", "status", "amount"], "rowCount": 3 },
        "app.customers": { "owner": "app_owner", "columns": ["id", "name", "phone"], "rowCount": 2 }
      },
      "grants": [
        { "priv": "CONNECT", "object": "database:appdb", "role": "omm" },
        { "priv": "USAGE", "object": "schema:app", "role": "app_owner" },
        { "priv": "SELECT", "object": "table:app.orders", "role": "app_rw" },
        { "priv": "UPDATE", "object": "table:app.orders", "role": "app_rw" }
      ],
      "session": { "role": "omm", "in_tx": false, "savepoints": [] }
    }
  },
  {
    "id": "kp-lab-scan-01",
    "kind": "audit",
    "mode": "audit",
    "level": "L1",
    "title": "迁移依赖审查：给 6 个组件定处理方式",
    "subtitle": "把证据读成结论",
    "domain": "kp",
    "topic_id": "kp-02",
    "section_id": "kp-02-02",
    "version": "Kunpeng DevKit / AArch64",
    "minutes": 10,
    "scenario": "要把一套 x86_64 上的 Java Web 应用迁到鲲鹏。下面是盘点时采到的证据，请给每个组件判定处理方式。判错一项就说明有一个风险点会被漏掉。",
    "objectives": [
      "从 file / readelf / unzip / rpm 的输出里读出架构结论",
      "区分“字节码跨架构”与“本地库不跨架构”",
      "给每个组件定处理方式而不是笼统说“重编译”"
    ],
    "options": [
      { "id": "A", "label": "可直接运行或安装" },
      { "id": "B", "label": "需从源码重新编译" },
      { "id": "C", "label": "需替换本地库或基础镜像" },
      { "id": "D", "label": "无法直接使用，需要重做" }
    ],
    "items": [
      {
        "id": "i1",
        "name": "app.jar（业务主包）",
